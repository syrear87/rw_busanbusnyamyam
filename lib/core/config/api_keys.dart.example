/// API 키 관리 템플릿
///
/// 이 파일을 복사하여 api_keys.dart를 만들고 실제 키를 입력하세요.
/// api_keys.dart는 .gitignore에 등록되어 있어 버전 관리에서 제외됩니다.
/// 실제 키는 각 개발자가 로컬에서 직접 설정해야 합니다.
class ApiKeys {
  // BIS API 서비스 키 (공공데이터포털에서 발급)
  static const String bisServiceKey = 'YOUR_BIS_SERVICE_KEY';

  // Google Maps API 키 (Google Cloud Console에서 발급)
  static const String googleMapsAndroidKey = 'YOUR_GOOGLE_MAPS_ANDROID_KEY';
  static const String googleMapsIosKey = 'YOUR_GOOGLE_MAPS_IOS_KEY';
}
